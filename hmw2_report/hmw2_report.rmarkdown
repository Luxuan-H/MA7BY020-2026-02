#-------------------------------
# Helper function: long table into wide table (proportions)
#
make_wide <- function(df, label) {
  df |>
    dplyr::group_by(bureau, nuance) |>
    dplyr::summarise(votes = sum(votes, na.rm = TRUE), .groups = "drop") |>
    dplyr::group_by(bureau) |>
    dplyr::mutate(pct = votes / sum(votes)) |>
    dplyr::ungroup() |>
    dplyr::select(bureau, nuance, pct) |>
    tidyr::pivot_wider(names_from = nuance, values_from = pct, values_fill = 0) |>
    dplyr::rename_with(~ paste0(label, "_", .), -bureau) |>
    dplyr::select(where(~ !all(. == 0)))
}

# Ensure all wide tables have the full set of 5 political bloc columns
ensure_nuances <- function(wide_df, prefix) {
  nuances <- c("extreme_gauche", "gauche", "centre", "droite", "extreme_droite")
  expected_cols <- paste0(prefix, "_", nuances)
  for (col in expected_cols) {
    if (!col %in% names(wide_df)) {
      message("Adding missing column: ", col)
      #wide_df[[col]] <- 0
    }
  }
  wide_df
}


#prepare for cca
to_share_matrix <- function(wide_df) {
  # Remove duplicate bureaux before converting to matrix
  wide_df <- wide_df |> dplyr::distinct(bureau, .keep_all = TRUE)
  mat <- wide_df |>
    dplyr::select(-bureau) |>
    as.matrix()
  rownames(mat) <- wide_df$bureau
  mat
}

#  Generate wide tables
w_eu14    <- make_wide(europe2014_clean,  "eu14")
w_p17r1   <- make_wide(pres2017_r1_clean, "p17r1")
w_p17r2   <- make_wide(pres2017_r2_clean, "p17r2")
w_leg17r1 <- make_wide(leg2017_r1_clean,  "leg17r1")
w_leg17r2 <- make_wide(leg2017_r2_clean,  "leg17r2")  
w_mun20r1 <- make_wide(mun2020_clean_r1,  "mun20r1")
w_mun20r2 <- make_wide(mun2020_clean_r2,  "mun20r2")
w_p22r1   <- make_wide(pres2022_r1_clean, "p22r1")
w_p22r2   <- make_wide(pres2022_r2_clean, "p22r2")


w_eu14    <- ensure_nuances(w_eu14,    "eu14")
w_p17r1   <- ensure_nuances(w_p17r1,   "p17r1")
w_p17r2   <- ensure_nuances(w_p17r2,   "p17r2")
w_leg17r1 <- ensure_nuances(w_leg17r1, "leg17r1")
w_leg17r2 <- ensure_nuances(w_leg17r2, "leg17r2")
w_mun20r1 <- ensure_nuances(w_mun20r1, "mun20r1")
w_mun20r2 <- ensure_nuances(w_mun20r2, "mun20r2")
w_p22r1   <- ensure_nuances(w_p22r1,   "p22r1")
w_p22r2   <- ensure_nuances(w_p22r2,   "p22r2")

#prepare for cca
sm_eu14    <- to_share_matrix(w_eu14)
sm_p17r1   <- to_share_matrix(w_p17r1)
sm_p17r2   <- to_share_matrix(w_p17r2)
sm_leg17r1 <- to_share_matrix(w_leg17r1)
sm_leg17r2 <- to_share_matrix(w_leg17r2)
sm_mun20r1 <- to_share_matrix(w_mun20r1)
sm_mun20r2 <- to_share_matrix(w_mun20r2)
sm_p22r1   <- to_share_matrix(w_p22r1)
sm_p22r2   <- to_share_matrix(w_p22r2)

# Merge all elections
all_elections <- w_eu14 |>
  dplyr::inner_join(w_p17r1,   by = "bureau") |>
  dplyr::inner_join(w_p17r2,   by = "bureau") |>
  dplyr::inner_join(w_leg17r1, by = "bureau") |>
  dplyr::inner_join(w_leg17r2, by = "bureau") |>
  dplyr::inner_join(w_mun20r1, by = "bureau") |>
  dplyr::inner_join(w_mun20r2, by = "bureau") |>
  dplyr::inner_join(w_p22r1,   by = "bureau") |>
  dplyr::inner_join(w_p22r2,   by = "bureau")

# Remove NA
all_elections_clean <- na.omit(all_elections)

# Check
# cat(" Polling stations:", nrow(all_elections_clean), "\n")
# cat(" Variables:", ncol(all_elections_clean) - 1, "\n")

